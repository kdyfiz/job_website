# Frontend (Vite). Leave empty in local dev to use the Vite /api proxy.
# On Cloudflare Pages, set this to the Render API origin, e.g. https://jobscout-api.onrender.com
VITE_API_BASE_URL=http://localhost:5080

# Backend CORS — comma-separated origins are not used; set array indices:
# Cors__AllowedOrigins__0=http://localhost:5173
# https://*.pages.dev is already allowed in code. Add a custom domain here if you use one.
