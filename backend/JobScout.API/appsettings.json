{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Matching": {
    "SkillsWeight": 0.6,
    "ExperienceWeight": 0.2,
    "LocationWeight": 0.1,
    "KeywordWeight": 0.1
  },
  "JobSearch": {
    "UseLiveListings": true
  },
  "Cv": {
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".pdf" ],
    "AllowedContentTypes": [ "application/pdf" ]
  }
}
